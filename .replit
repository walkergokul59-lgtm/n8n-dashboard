modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "5000"
N8N_BASE_URL = "http://localhost:5678"
N8N_API_TOKEN = "placeholder-configure-in-secrets"
N8N_API_BASE_PATH = "/api/v1"
N8N_AUTH_TYPE = "bearer"
APP_AUTH_SECRET = "replit-dashboard-secret-change-me"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server/index.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server/index.js", "--prod"]
build = ["npm", "run", "build"]
