# ── Google Sheets Database ──────────────────────────────────────────────────────
# Base64-encoded service account JSON (or raw JSON)
GOOGLE_SERVICE_ACCOUNT_
# Spreadsheet ID from the Google Sheets URL
GOOGLE_SHEETS_SPREADSHEET_ID=1WlZ5Lnam6yU0dSzbEmWi0IzAd8RBLZWclIxO12e_rCU

# ── Gmail SMTP (for password reset & support ticket emails) ─────────────────
GMAIL_USER=walkergokul59@gmail.com
GMAIL_APP_PASSWORD=mirz qaay ryok bsky

# ── App Authentication ──────────────────────────────────────────────────────────
APP_AUTH_SECRET=change-this-to-a-long-random-string

# ── Google OAuth (frontend sign-in button) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── n8n Connection ──────────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_TOKEN=
N8N_API_BASE_PATH=/api/v1
N8N_AUTH_TYPE=bearer

# ── n8n Webhooks (for email delivery via n8n workflows) ─────────────────────────
# Base URL of your n8n instance for webhook calls (may differ from N8N_BASE_URL)
# When set, password reset and support ticket emails are sent via n8n webhooks.
# When not set, falls back to Gmail SMTP (GMAIL_USER / GMAIL_APP_PASSWORD).
N8N_WEBHOOK_BASE_URL=
# Optional: custom webhook path for support ticket notifications (default: /webhook/support_ticket)
N8N_SUPPORT_WEBHOOK_PATH=/webhook/support_ticket

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=5173
